{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @bethere/mobile build:web",
  "outputDirectory": "apps/mobile/dist",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": null,
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" != \"main\" ] && [ \"$VERCEL_GIT_COMMIT_REF\" != \"dev\" ]",
  "rewrites": [
    { "source": "/m/:id", "destination": "/api/m/:id" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
