# Base URL of the backend the app talks to. EXPO_PUBLIC_* vars are inlined by Metro
# at build time. Leave unset for local dev (defaults to http://localhost:3000).
# Live backend:
# EXPO_PUBLIC_API_URL=https://96mgvmgcbj.us-east-1.awsapprunner.com

# Clerk publishable key - REQUIRED for the app to boot (ClerkProvider needs it even when
# you use the dev-bypass button). Copy from the Clerk dashboard. Put the real value in
# apps/mobile/.env (gitignored). `pnpm web` reads it from there.
# EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Set to 1 to show the "Continue as test user" dev-bypass button (signs in as u_dev).
# `pnpm web` sets this automatically; the hosted/web deploy should leave it unset.
# EXPO_PUBLIC_DEV_AUTH=1
