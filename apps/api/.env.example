DATABASE_URL=postgres://drp:drp@localhost:5433/drp
PORT=3000

# Demo seeding on boot: "reset" (default; wipes + reseeds each boot, for local dev),
# "if-empty" (seed only a fresh DB, used on the live backend), or "off".
# SEED_ON_BOOT=reset

# Path to a CA bundle for verifying TLS to the database (set in the Docker image for RDS).
# Leave unset locally - plaintext is used for a localhost connection.
# DATABASE_CA_PATH=/app/rds-ca.pem

# DANGER one-shot: "true" drops + recreates the public schema before migrating. Only for a
# deliberate migration-baseline reset (see docs/runbook-deploy.md). Default off. Never leave
# it on - it wipes the database on every boot.
# DB_RESET_ON_BOOT=false

# Auth
DEV_AUTH_BYPASS=1            # accept x-user-id stub when no bearer token (local + M2 prod)
CLERK_JWT_KEY=...            # PEM public key for networkless Clerk token verification
CLERK_SECRET_KEY=sk_...      # Clerk backend key (reserved; not required for verifyToken)
