{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "command -v knownissue >/dev/null 2>&1 && knownissue hook || true",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "command -v knownissue >/dev/null 2>&1 && knownissue hook || true",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "command -v knownissue >/dev/null 2>&1 && knownissue hook || true",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "command -v knownissue >/dev/null 2>&1 && knownissue hook || true",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
